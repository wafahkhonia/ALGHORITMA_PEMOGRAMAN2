# ==============================================================================
# NOMOR 1 (MENANGANI UNTUK: Membuat tuple dan tampilkan)
# ==============================================================================
tuple_1 = (1, 2, 4, 8)
tuple_2 = 1., .5, .25, .125      # tuple tanpa kurung (dipisah koma)
tuple_kosong = ()                # tuple kosong
tuple_satu = (99,)               # tuple dengan 1 elemen (wajib ada koma)

print("tuple_1 :", tuple_1)
print("tuple_2 :", tuple_2)
print("tuple_kosong :", tuple_kosong)
print("tuple_satu :", tuple_satu)


# ==============================================================================
# NOMOR 2 (MENANGANI UNTUK: Menggunakan tuple)
# ==============================================================================
belasan = (11, 12, 13, 14, 15)

print(belasan[0])   
print(belasan[-2])  
print(belasan[2:4])   

# Menampilkan semua elemen dengan for loop
for elemen in belasan:
    print(elemen)


# ==============================================================================
# NOMOR 3 (MENANGANI UNTUK: Memodifikasi tuple)
# ==============================================================================
ratusan = (100, 200, 300, 400, 500)

# Menambah elemen di akhir
ratusan_baru = ratusan + (800,)
print(ratusan_baru)    # → (100, 200, 300, 400, 500, 800)

# Menambah elemen di awal
ratusan_baru = (0,) + ratusan_baru
print(ratusan_baru)    # → (0, 100, 200, 300, 400, 500, 800)


# ==============================================================================
# NOMOR 4 (MENANGANI UNTUK: Menggunakan tuple dengan len(), +, *, in dan not in)
# ==============================================================================
tupleee = (11, 22, 33, 44, 55)

# len()
print(len(tupleee))

# operator +
t1 = tupleee + (100, 1000)
print(t1)

# operator *
t2 = tupleee * 3
print(t2)

# operator in
print(22 in tupleee)

# operator not in
print(77 not in tupleee)


