# NOMOR 8 (MENANGANI UNTUK: Method keys())
# ==============================================================================
dictionary = {"green": "hijau", "blue": "biru", "yellow": "kuning"}

# Menggunakan method keys()
for kunci in dictionary.keys():
    print(kunci, "->", dictionary[kunci])


# ==============================================================================
# NOMOR 9 (MENANGANI UNTUK: Method values())
# ==============================================================================
dictionary = {"green": "hijau", "blue": "biru", "yellow": "kuning"}

for nilai in dictionary.values():
    print(nilai)


# ==============================================================================
# NOMOR 10 (MENANGANI UNTUK: Method items())
# ==============================================================================
dictionary = {"bonjour": "halo", "merci": "terima kasih", "oui": "ya"}

# Menggunakan method items()
print("=== Prancis - Indonesia ===")
for prancis, indo in dictionary.items():
    print(prancis, "->", indo)


# ==============================================================================
# NOMOR 11 (MENANGANI UNTUK: Method update())
# ==============================================================================
dictionary = {"apple": "apel", "mango": "mangga", "grape": "anggur"}
print("Sebelum update:", dictionary)

# Menambah pasangan kunci-nilai baru menggunakan update()
dictionary.update({'watermelon': 'semangka'})
print("Sesudah update:", dictionary)


# ==============================================================================
# NOMOR 12 (MENANGANI UNTUK: Method popitem())
# ==============================================================================
dictionary = {"apple": "apel", "mango": "mangga", "grape": "anggur"}
print("Sebelum update:", dictionary)

# Menambah pasangan kunci-nilai baru menggunakan update()
dictionary.update({'watermelon': 'semangka'})
print("Sesudah update:", dictionary)

# Menggunakan popitem()
kunci, nilai = dictionary.popitem()
print("Elemen yang dihapus:", kunci, "->", nilai)
print("Sesudah popitem:", dictionary)


# ==============================================================================
# NOMOR 13 (MENANGANI UNTUK: Modifikasi dictionary)
# ==============================================================================
# Membuat dictionary
dictionary = {"apple": "apel", "mango": "mangga", "grape": "anggur"}
print("Awal:", dictionary)

# Memasukkan nilai baru ke kunci yang ada
dictionary['apple'] = 'apel malang'
print("Setelah ubah nilai:", dictionary)

# Menghapus item spesifik
del dictionary['mango']
print("Setelah hapus mango:", dictionary)

# Mengurutkan isi dictionary
for key in sorted(dictionary.keys()):
    print(key, "->", dictionary[key])


