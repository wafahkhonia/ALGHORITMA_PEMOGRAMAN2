# NOMOR 14 (MENANGANI UNTUK: Menangani Exception (try-except))
# ==============================================================================
while True:
    try:
        umur = int(input("masukkan umur kamu: "))
        print("umur kamu adalah", umur, "tahun")
        break
    except:
        print("Peringatan: umur harus berupa angka!")


# ==============================================================================
# NOMOR 15 (MENANGANI UNTUK: Menangani multiple exception)
# ==============================================================================
while True:
    try:
        buah = input("masukkan nama buah: ")
        harga = int(input("masukkan harga buah: "))
        jumlah = int(input("masukkan jumlah buah: "))
        total = harga * jumlah
        print("total harga", buah, "adalah", total)
        break
    except ValueError:
        print("Peringatan: harga dan jumlah harus berupa angka!")
    except:
        print("Maaf sepertinya ada yang salah nih... :(")