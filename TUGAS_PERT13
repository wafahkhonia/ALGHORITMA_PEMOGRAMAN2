# NOMOR 5 (MENANGANI UNTUK: Penugasan simultan pada tuple)
# ==============================================================================
# Menukar nilai antar variabel tanpa variabel sementara
a = 100
b = 200
c = 300

print("Sebelum :", a, b, c)

