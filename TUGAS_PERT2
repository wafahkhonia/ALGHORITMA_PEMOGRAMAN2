# Operator biner (beroperasi pada dua operand)
print(5 + 3)       # Penjumlahan biner: 5 + 3 = 8
print(5 - 3)       # Pengurangan biner: 5 - 3 = 2
print(5 * 3)       # Perkalian biner: 5 * 3 = 15
print(5 / 3)       # Pembagian biner: 5 / 3 = 1.6666...
print(5 // 3)      # Pembagian bulat biner: 5 // 3 = 1
print(5 % 3)       # Modulo biner: 5 % 3 = 2
print(5 ** 3)      # Pangkat biner: 5 ** 3 = 125
print(5 > 3)       # Perbandingan biner: 5 > 3 = True
print(5 == 3)      # Kesetaraan biner: 5 == 3 = False
print(5 and 3)     # Logika AND biner: 5 and 3 = 3
print(5 or 3)      # Logika OR biner: 5 or 3 = 5

