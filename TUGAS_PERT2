#no 3
print(0o755) # Octal: 755 = 493 dalam desimal,755 = (7x8^2) + (5x8^1) + (5x8^0) = 448 + 40 + 5 = 493
print(0o12)  # Octal: 12 = 10 dalam desimal, 12 = (1x8^1) + (2x8^0) = 8 + 2 = 10

# Hexadecimal dimulai dengan (0x) basis 16,
print(0xFF)  # Hex: FF = 255 dalam desimal, 255 = (15x16^1) + (15x16^0) = (15x16) + (15x1) = 240 + 15 = 255
print(0x1A)  # Hex: 1A = 26 dalam desimal, 26 = (1x16^1) + (10x16^0) = (1x16) + (10x1) = 16 + 10 = 26

