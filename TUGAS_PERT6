# No. 8 (Game Tebak Angka Versi 2 - while True)
# ==========================================
secret_number = 777

print(
"""
+=======================================+
| Selamat datang di game saya, muggle!  |
|                                       |
| Masukkan suatu angka dan tebak        |
| angka berapa yang saya  pilih         |
| untukmu.                              |
|                                       |
