# ==========================================
# No. 3 (Program Penghitung Ganjil Genap)
# ==========================================
Angka_Genap = 0
Angka_Ganjil = 0
 
Angka = int(input("Masukkan suatu angka (Jika ingin berhenti ketik angka 0): "))
 
while Angka != 0:
    if Angka % 2 == 1:
        Angka_Ganjil += 1
    else:
        Angka_Genap += 1
 
    Angka = int(input("Masukkan suatu angka (Jika ingin berhenti ketik angka 0): "))
 
print("Jumlah Angka Ganjil: ", Angka_Ganjil)
print("Jumlah Angka Genap: ", Angka_Genap)


