# No. 13 (Bitwise Shift)
# ==========================================
A = 15 #biner 1111

print (A << 1) #bit biner dari angka 15 ke arah kiri sebanyak 1 kali. sehingga biner 11110 (30)

print (A >> 1) #bit biner dari angka 15 ke arah kanan sebanyak 1 kali. sehingga 1 yang berada di posisi paling kanan akan terdorong keluar (hilang). Hasilnya menjadi sisa 3 digit saja: 111 (7)


