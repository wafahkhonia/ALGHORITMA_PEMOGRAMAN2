# ==========================================
# No. 5 (Eksperimen range() A sampai E)
# ==========================================
for A in range (5):                      #range(5)Menghasilkan urutan angka mulai dari 0 sampai 4 (total 5
    #angka).
    print ("Nilai A saat ini adalah", A)
print()

for B in range (5, 9):                   #range(5, 9)Menentukan batas bawah (5) dan batas atas (9). Perlu
#diingat, angka terakhir (9) tidak diikutsertakan. Hasil: Mencetak angka 5, 6, 7, dan 8.
    print ("Nilai B saat ini adalah", B)
print()

for C in range (1, 5, 9):                #range (1, 5, 9)Formatnya adalah range(mulai, berhenti, langkah).
#Hanya mencetak angka 1, karena setelah angka 1 kamu disuruh loncat 9 langkah (ke angka 10), tapi dilarang
#melewati batas angka 5.
    print ("Nilai C saat ini adalah", C)
print()

for D in range (2, 2):                   #Tidak mencetak apa pun. Karena mulai di angka 2 dan berhenti
#sebelum angka 2, sehingga tidak ada ruang untuk berjalan.
    print ("Nilai D saat ini adalah", D)
print()

for E in range (8, 3):                   #Tidak mencetak apa pun. Karena mulai di angka 8 dan sudah
#melewati batasberhentinya (3), sehingga tidak ada ruang untuk berjalan.
    print ("Nilai E saat ini adalah", E)
print()


# ==========================================
# No. 6 (Perulangan Pangkat dengan For)
# ==========================================
Power = 1   #variabel bernama Power bernilai 1

#for expo membuat variabel baru bernama expo yang nilainya akan berubah otomatis di setiap putaran.
for expo in range (11):   #menghasilkan deretan angka mulai dari 0 sampai 10 (totalnya ada 11)
    print ("2 Pangkat ", expo, "adalah", Power)
    Power *= 2
    #nilai di dalam variabel Power yang sekarang akan dikalikan dengan 2, lalu hasilnya disimpan
    #kembali ke dalam variabel Power untuk digunakan pada putaran berikutnya.


# ==========================================
# No. 7 (Instruksi Break dan Continue)
# ==========================================
#Break(menghentikan paksa seluruh perulangan saat kondisi tertentu terpenuhi)
print ("Intruksi Break: ")
for i in range (1, 7):
    if i == 4:
        break
    print ("Bagian ini ada di dalam Loop", i)
print("Bagian ini ada di luar Loop")

#Continue(melewati sisa perintah di putaran saat ini dan langsung melompat ke putaran berikutnya)
print ("\nIntruksi Continue:")
for i in range (1, 6):
    if i == 2:
        continue
    print ("Bagian ini ada di dalam Loop", i)
print("Bagian ini ada di luar Loop")


